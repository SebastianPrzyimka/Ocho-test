---
import Button from "./Button.astro";
import Wordmark from "./Wordmark.astro";
import { nav, site, fullAddress } from "../config/site";

const path = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-ivory transition-colors duration-300">
  <div class="container-x flex h-18 items-center justify-between gap-6 lg:h-20">
    <a href="/" class="flex flex-col leading-none text-navy">
      <Wordmark class="text-xl lg:text-2xl" />
      <span class="mt-1.5 hidden text-[0.65rem] font-semibold tracking-[0.2em] text-muted uppercase sm:block">
        Speirs Wharf · Glasgow
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-semibold">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class="relative py-2 text-ink transition-colors hover:text-rust aria-[current=page]:text-navy after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <Button href="/order/" variant="secondary" aria-current={isCurrent("/order/") ? "page" : undefined}>Order Online</Button>
      <Button href="/booktable/" aria-current={isCurrent("/booktable/") ? "page" : undefined}>Book a Table</Button>
    </div>

    <button
      type="button"
      class="inline-flex min-h-11 items-center gap-3 rounded-full border-2 border-navy px-4 text-sm font-bold text-navy lg:hidden"
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      data-menu-open
    >
      Menu
      <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1 4h14M1 8h14M1 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<dialog id="mobile-menu" aria-label="Site menu" class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-navy p-0 text-ivory">
  <div class="flex min-h-full flex-col">
    <div class="container-x flex h-18 items-center justify-between">
      <Wordmark class="text-xl" />
      <button
        type="button"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-ivory/70 px-4 text-sm font-bold"
        data-menu-close
      >
        Close
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Site" class="container-x flex-1 pt-6">
      <ul class="space-y-1">
        {
          nav.map((item, i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class="font-display flex min-h-14 items-center text-[2.6rem] leading-none font-medium aria-[current=page]:text-apricot aria-[current=page]:italic"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="container-x space-y-6 pt-8 pb-10">
      <div class="grid grid-cols-2 gap-3">
        <Button href="/booktable/" variant="accent" size="lg">Book a Table</Button>
        <Button href="/order/" variant="outline-light" size="lg">Order Online</Button>
      </div>
      <p class="text-sm leading-relaxed text-sand">
        {fullAddress}<br />
        <a class="underline underline-offset-4" href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
      </p>
    </div>
  </div>
</dialog>

<style>
  .mobile-menu::backdrop {
    background: var(--color-midnight);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 0.45s var(--ease-out-soft);
    }
    .mobile-menu[open] .menu-item {
      animation: item-in 0.6s var(--ease-out-soft) both;
      animation-delay: calc(var(--i) * 50ms + 80ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -1rem;
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const dialog = document.getElementById("mobile-menu") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  opener?.addEventListener("click", () => dialog?.showModal());
  dialog?.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("close", () => opener?.focus());
  // Close the menu if the screen grows to desktop size while it is open.
  matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && dialog?.close());

  const onScroll = () => header?.classList.toggle("border-sand", window.scrollY > 8);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });
</script>
