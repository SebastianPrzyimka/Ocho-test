---
import { dietaryLabels, type MenuCategory } from "../content/menu";

interface Props {
  category: MenuCategory;
  index: number;
}
const { category, index } = Astro.props;
---

<section id={category.id} class="scroll-mt-40 border-t border-navy/15 py-14 md:py-20" aria-labelledby={`${category.id}-title`}>
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <div class="lg:sticky lg:top-44">
        <p class="font-display text-lg text-rust italic">{String(index + 1).padStart(2, "0")}</p>
        <h2 id={`${category.id}-title`} class="display-md mt-2 text-navy">{category.title}</h2>
        <p class="mt-4 max-w-xs text-muted">{category.intro}</p>
        {category.note && <p class="mt-3 text-sm font-semibold text-navy">{category.note}</p>}
      </div>
    </div>
    <ul class="grid gap-x-12 lg:col-span-8 md:grid-cols-2">
      {
        category.items.map((item) => (
          <li class="border-b border-dotted border-navy/25 py-6" data-reveal>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-xl font-semibold text-navy">{item.name}</h3>
              <span class:list={["shrink-0 font-bold", item.price ? "text-navy" : "text-muted"]}>
                {item.price ?? <span class="tbc">Price tbc</span>}
              </span>
            </div>
            {item.description && <p class="mt-2 text-muted">{item.description}</p>}
            {(item.dietary?.length || item.placeholder) && (
              <ul class="mt-3 flex flex-wrap gap-2 text-xs font-bold">
                {item.dietary?.map((d) => (
                  <li class="rounded-full bg-leaf/10 px-2.5 py-1 text-leaf">
                    <abbr title={dietaryLabels[d]} class="no-underline">
                      {d}
                    </abbr>
                  </li>
                ))}
                {item.placeholder && (
                  <li class="rounded-full border border-dashed border-rust px-2.5 py-1 tracking-wide text-rust uppercase">
                    Placeholder
                  </li>
                )}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
