---
/** Always-visible Book / Order bar on phones, so the two key actions are one tap away. */
interface Props {
  hide?: boolean;
}
const { hide = false } = Astro.props;
---

{
  !hide && (
    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-sand bg-ivory/95 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] lg:hidden">
      <nav aria-label="Quick actions" class="grid grid-cols-2 gap-2">
        <a
          href="/booktable/"
          class="flex min-h-12 items-center justify-center rounded-full bg-navy text-sm font-bold text-ivory"
        >
          Book a Table
        </a>
        <a
          href="/order/"
          class="flex min-h-12 items-center justify-center rounded-full border-2 border-navy text-sm font-bold text-navy"
        >
          Order Online
        </a>
      </nav>
    </div>
  )
}
