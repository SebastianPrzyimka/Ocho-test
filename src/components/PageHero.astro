---
/** Editorial page header used on inner pages. Pass a photo id for the split layout. */
import Photo from "./Photo.astro";
import type { PhotoId } from "../content/photos";

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  photo?: PhotoId;
  photoTone?: "navy" | "sand" | "linen" | "midnight";
  /** Smaller header, so content below (e.g. the ordering widget) starts higher up. */
  compact?: boolean;
}
const { eyebrow, title, intro, photo, photoTone = "navy", compact = false } = Astro.props;
---

<section class:list={["relative overflow-hidden", compact ? "pt-8 pb-8 md:pt-10 md:pb-10" : "pt-10 pb-14 md:pt-16 md:pb-20"]}>
  <div class:list={["container-x grid gap-10", photo && "lg:grid-cols-12 lg:items-end"]}>
    <div class:list={[photo ? "lg:col-span-7" : "max-w-4xl"]}>
      <p class="eyebrow flex items-center gap-3 text-rust" data-reveal>
        <span class="size-2 rounded-full bg-leaf" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 class:list={[compact ? "display-lg" : "display-xl", "mt-5 text-navy"]} data-reveal style="--reveal-delay:1">{title}</h1>
      {
        intro && (
          <p class:list={[compact ? "mt-4 text-lg" : "mt-7 text-lg md:text-xl", "max-w-2xl leading-relaxed text-muted"]} data-reveal style="--reveal-delay:2">
            {intro}
          </p>
        )
      }
      <slot />
    </div>
    {
      photo && (
        <div class="lg:col-span-5" data-reveal style="--reveal-delay:2">
          <Photo id={photo} aspect="4 / 5" tone={photoTone} priority sizes="(min-width: 1024px) 40vw, 100vw" class="rounded-t-[12rem] rounded-b-md" />
        </div>
      )
    }
  </div>
</section>
