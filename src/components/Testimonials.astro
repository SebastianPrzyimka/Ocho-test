---
import SectionHeading from "./SectionHeading.astro";
import { testimonials } from "../content/testimonials";
import { isProduction } from "../config/site";
---

{
  testimonials.length > 0 ? (
    <section class="bg-linen py-20 md:py-28" aria-labelledby="reviews-title">
      <div class="container-x">
        <SectionHeading eyebrow="Guest reviews" title="Kind words" id="reviews-title" />
        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {testimonials.map((t, i) => (
            <li class="flex" data-reveal style={`--reveal-delay:${i}`}>
              <figure class="flex flex-col justify-between rounded-md bg-ivory p-8">
                <blockquote class="font-display text-xl leading-snug text-navy">“{t.quote}”</blockquote>
                <figcaption class="mt-8 text-sm text-muted">
                  <span class="font-bold text-ink">{t.author}</span> ·{" "}
                  {t.url ? (
                    <a href={t.url} class="underline underline-offset-4" rel="noopener noreferrer" target="_blank">
                      {t.source}
                    </a>
                  ) : (
                    t.source
                  )}
                  {t.date && <span> · {t.date}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : (
    !isProduction && (
      <section class="py-16" aria-label="Guest reviews placeholder">
        <div class="container-x">
          <div class="rounded-md border-2 border-dashed border-sand p-8 text-center text-muted">
            <p class="eyebrow text-rust">Guest reviews</p>
            <p class="mt-3">
              Hidden until verified reviews are supplied (with permission and source). Add them in
              <code class="font-mono text-sm">src/content/testimonials.ts</code>.
            </p>
          </div>
        </div>
      </section>
    )
  )
}
