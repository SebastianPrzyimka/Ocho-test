---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Photo from "../components/Photo.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CtaBand from "../components/CtaBand.astro";
import { isProduction } from "../config/site";

const values = [
  { word: "Fresh", text: "Food prepared in our own kitchen." },
  { word: "Local", text: "An independent Glasgow café, proud of where we are." },
  { word: "Home made", text: "Made by hand, the way we like to eat." },
];
---

<BaseLayout
  title="About Ocho"
  description="The story of Ocho: an independent café on the canal at Speirs Wharf, Glasgow, in part of the original 1851 heritage building. Fresh, local, home made and dog friendly."
>
  <PageHero
    eyebrow="About Ocho"
    title="A café on the canal."
    intro="Independent, welcoming and proudly local. Ocho brings fresh, home-made food to the banks of Speirs Wharf."
    photo="shopfront"
  />

  <!-- Setting -->
  <section class="py-16 md:py-28" aria-labelledby="setting-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 lg:order-2">
        <Photo id="canalView" aspect="5 / 4" parallax sizes="(min-width: 1024px) 55vw, 100vw" class="rounded-md" />
      </div>
      <div class="lg:col-span-5 lg:order-1">
        <SectionHeading number="01" eyebrow="The setting" title="Speirs Wharf, on the water." id="setting-title" size="md">
          <div class="prose-ocho mt-6 text-lg leading-relaxed text-muted">
            <p>
              Ocho sits on the banks of Speirs Wharf, beside the canal in Glasgow. The water, the old stone and the
              open sky make it a calm place to stop, whether you've come for brunch or are passing by on a walk.
            </p>
          </div>
        </SectionHeading>
      </div>
    </div>
  </section>

  <!-- Building -->
  <section class="bg-navy py-16 text-ivory md:py-28" aria-labelledby="building-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <p class="font-display text-[clamp(6rem,22vw,15rem)] leading-[0.8] font-semibold text-ivory/90" aria-hidden="true">
          1851
        </p>
      </div>
      <div class="lg:col-span-6">
        <SectionHeading number="02" eyebrow="The building" title="Part of a heritage building." tone="light" id="building-title" size="md">
          <div class="prose-ocho mt-6 text-lg leading-relaxed text-sand">
            <p>
              Our home is part of the original 1851 heritage building at Speirs Wharf. Behind the navy shopfront and
              white OCHO lettering, the café brings new life to a piece of Glasgow's canal-side history.
            </p>
          </div>
        </SectionHeading>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 md:py-28" aria-labelledby="values-title">
    <div class="container-x">
      <SectionHeading number="03" eyebrow="What we stand for" title="Fresh · Local · Home made." id="values-title" />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {
          values.map((v, i) => (
            <li class="rounded-md border border-navy/15 bg-linen p-8" data-reveal style={`--reveal-delay:${i}`}>
              <p class="font-display text-4xl font-semibold text-navy italic">{v.word}</p>
              <p class="mt-3 text-muted">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Atmosphere and dogs -->
  <section class="pb-16 md:pb-28" aria-labelledby="welcome-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="grid grid-cols-2 gap-4 lg:col-span-7">
        <Photo id="interiorBar" aspect="3 / 4" tone="linen" sizes="(min-width: 1024px) 28vw, 50vw" class="rounded-md" />
        <Photo id="dogFriendly" aspect="3 / 4" tone="sand" sizes="(min-width: 1024px) 28vw, 50vw" class="mt-12 rounded-md" />
      </div>
      <div class="lg:col-span-5">
        <SectionHeading number="04" eyebrow="The welcome" title="Relaxed, licensed and dog friendly." id="welcome-title" size="md">
          <div class="prose-ocho mt-6 text-lg leading-relaxed text-muted">
            <p>
              Ocho is fully licensed, so brunch can come with a cocktail. And because a walk along the canal is
              better with company, dogs are welcome too.
            </p>
          </div>
        </SectionHeading>
      </div>
    </div>
  </section>

  {
    !isProduction && (
      <section class="pb-16" aria-label="Owner story placeholder">
        <div class="container-x">
          <div class="rounded-md border-2 border-dashed border-rust/50 p-8 text-rust">
            <p class="eyebrow">Owner story to come</p>
            <p class="mt-3 max-w-2xl">
              Space for the owners' own words: how Ocho started, the people behind it and what makes it special.
              Nothing here is invented. Supply the story and it will replace this box.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
