---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import HoursTable from "../components/HoursTable.astro";
import Photo from "../components/Photo.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../config/site";
import { restaurantSchema } from "../config/schema";
import { diningHours, collectionHours, hoursNote } from "../content/hours";

/** Practical details still to be confirmed by the owner. Replace `null` with text. */
const practical: { title: string; text: string | null }[] = [
  { title: "Getting here", text: null },
  { title: "Parking", text: null },
  { title: "Access", text: null },
];
---

<BaseLayout
  title="Visit & Contact"
  description="Find Ocho at 8 Speirs Wharf, Glasgow G4 9TB, on the canal. Address, phone, opening hours and directions."
  jsonLd={[restaurantSchema(Astro.site)]}
>
  <PageHero
    eyebrow="Visit & contact"
    title="Find us on the canal."
    intro="Ocho is at Speirs Wharf in Glasgow, beside the canal, behind the navy shopfront."
    photo="shopfront"
    photoTone="navy"
  />

  <section class="pb-16 md:pb-24" aria-label="Contact details">
    <div class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-md bg-navy p-8 text-ivory md:p-10">
        <h2 class="eyebrow text-apricot">Address</h2>
        <address class="mt-5 font-display text-3xl leading-tight not-italic">
          Ocho<br />{site.address.street}<br />{site.address.locality}
          {site.address.postcode}
        </address>
        <Button href={site.mapUrl} variant="outline-light" class="mt-8" external arrow>Open in maps</Button>
      </div>
      <div class="rounded-md bg-linen p-8 md:p-10">
        <h2 class="eyebrow text-rust">Phone & email</h2>
        <p class="mt-5">
          <a href={`tel:${site.phone.e164}`} class="font-display text-3xl text-navy underline decoration-sand decoration-2 underline-offset-8 hover:decoration-accent">
            {site.phone.display}
          </a>
        </p>
        <p class="mt-6 text-muted">
          {
            site.email ? (
              <a class="underline underline-offset-4" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            ) : (
              <span class="tbc text-rust">Email to be confirmed</span>
            )
          }
        </p>
        <h2 class="eyebrow mt-8 text-rust">Follow us</h2>
        <ul class="mt-3 flex flex-wrap gap-3">
          {
            site.social.map((s) =>
              s.url ? (
                <li>
                  <a class="font-bold text-navy underline underline-offset-4" href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ) : (
                <li class="text-muted">
                  {s.label} <span class="tbc text-rust">link tbc</span>
                </li>
              ),
            )
          }
        </ul>
      </div>
      <div class="rounded-md border border-navy/15 p-8 md:col-span-2 md:p-10 lg:col-span-1">
        <h2 class="eyebrow text-rust">Good to know</h2>
        <ul class="mt-5 space-y-3 text-navy">
          <li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-leaf" aria-hidden="true"></span>Dog friendly</li>
          <li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-leaf" aria-hidden="true"></span>Fully licensed</li>
          <li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-leaf" aria-hidden="true"></span>On the canal at Speirs Wharf</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-linen py-16 md:py-24" aria-labelledby="hours-title">
    <div class="container-x">
      <h2 id="hours-title" class="display-md text-navy" data-reveal>Opening hours</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div data-reveal>
          <h3 class="eyebrow text-rust">Eat in</h3>
          <HoursTable hours={diningHours} class="mt-4" caption="Dining hours" />
        </div>
        <div data-reveal style="--reveal-delay:1">
          <h3 class="eyebrow text-rust">Online orders</h3>
          <HoursTable hours={collectionHours} class="mt-4" caption="Online ordering hours" />
        </div>
      </div>
      {hoursNote && <p class="mt-6 text-sm text-muted">{hoursNote}</p>}
    </div>
  </section>

  <section class="py-16 md:py-24" aria-labelledby="directions-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <h2 id="directions-title" class="display-md text-navy" data-reveal>Getting to Ocho</h2>
        <dl class="mt-8 divide-y divide-navy/15 border-y border-navy/15">
          {
            practical.map((p) => (
              <div class="py-6" data-reveal>
                <dt class="font-display text-xl font-semibold text-navy">{p.title}</dt>
                <dd class="mt-2 text-muted">{p.text ?? <span class="tbc text-rust">To be confirmed</span>}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="grid grid-cols-2 gap-4 lg:col-span-7">
        <Photo id="doorDetail" aspect="3 / 4" tone="sand" sizes="(min-width: 1024px) 28vw, 50vw" class="rounded-md" />
        <Photo id="wharfEvening" aspect="3 / 4" tone="midnight" sizes="(min-width: 1024px) 28vw, 50vw" class="mt-12 rounded-md" />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
