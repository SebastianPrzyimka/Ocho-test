{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Test deployment only: an assets-only Worker that serves the static build in ./dist.
	// There is no server code. The name must match the project in the Cloudflare dashboard.
	// Production is meant to go to Cloudflare Pages by Direct Upload of the same ./dist folder (see README).
	"name": "ocho-test",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
